<script>
    const pageData = {
        feed: {
            title: '▶️ Watch',
        },
        campaigns: {
            title: '🎯 Campaigns',
        },
        grove: {
            title: '🌳 Your Grove',
        },
        analytics: {
            title: '📊 Impact',
        },
        profile: {
            title: '👤 Profile',
        }
    };

    function switchPage(page, btn) {
        document.querySelectorAll('.content').forEach(p => p.style.display = 'none');
        document.getElementById(page + 'Page').style.display = 'block';
        document.querySelector('.phone-content').scrollTop = 0;
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('headerTitle').textContent = pageData[page].title;
    }

    function copyCode() {
        const code = document.documentElement.outerHTML;
        navigator.clipboard.writeText(code).then(() => {
            alert('✅ Full code copied to clipboard!\n\n1. Create a new file: impactivate.html\n2. Paste the code\n3. Open in browser\n4. Share the file!');
        }).catch(() => {
            alert('📋 Code copied! (Paste into a new HTML file)');
        });
    }

    console.log('%c🌱 Impactivate is LIVE!', 'color: #7c5fa3; font-size: 20px; font-weight: bold;');
    console.log('%cYour app is deployed and ready to share!', 'color: #4caf50; font-size: 14px;');
</script>

